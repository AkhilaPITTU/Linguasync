# ==========================
# Application
# ==========================
APP_NAME=LINGUASYNC
APP_VERSION=1.0.0
DEBUG=True

# ==========================
# Server
# ==========================
HOST=0.0.0.0
PORT=8000
# "development" (default) keeps Uvicorn's auto-reload on, matching local
# dev today. Set to "production" before running run.py on a real server.
ENVIRONMENT=development

# ==========================
# MongoDB
# ==========================
MONGODB_URL=
DATABASE_NAME=linguasync

# ==========================
# JWT
# ==========================
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================
# Frontend
# ==========================
FRONTEND_URL=http://localhost:5173
# Comma-separated production frontend origins, e.g.
# https://app.example.com,https://example.com
# Leave blank to fall back to FRONTEND_URL alone (current behavior).
ALLOWED_ORIGINS=

# ==========================
# Email
# ==========================
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ==========================
# Upload Paths
# ==========================
UPLOAD_FOLDER=uploads
TRANSCRIPT_EXPORT_FOLDER=transcript_exports
OPENAI_API_KEY=
