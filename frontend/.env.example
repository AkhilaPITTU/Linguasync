# Copy to .env and fill in for your environment. Never commit real values.

# Leave blank to derive the API host from the browser URL (recommended for
# local dev and LAN testing), e.g. http://192.168.1.25:5173 -> http://192.168.1.25:8000.
# Set explicitly for production, e.g. https://api.example.com
VITE_API_URL=

# Leave blank to derive the WebSocket URL from VITE_API_URL / the browser
# URL (ws:// in dev, wss:// automatically once served over https).
# Set explicitly only if the WebSocket host differs from the API host.
VITE_WS_URL=

# Vite dev-server proxy, used only for local LAN/HTTPS testing
# (see .env.lan-https.example). Leave unset in production.
VITE_USE_VITE_PROXY=

# TURN/TURNS relay server(s) for WebRTC, required for calls to connect
# across mobile data, symmetric NAT, and restrictive firewalls. Comma
# separated list of URIs, e.g.:
# turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=

# Credentials for the TURN server(s) above. Never commit real values.
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
