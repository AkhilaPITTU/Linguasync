# Leave blank to derive the API host from the browser URL, e.g.
# http://192.168.1.25:5173 -> http://192.168.1.25:8000.
# Set VITE_API_URL only when frontend and backend run on different hosts.

# Leave blank locally. In production, set to a TURN/TURNS URI list
# (comma-separated), e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=

# Credentials for the TURN server above. Leave blank locally.
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
