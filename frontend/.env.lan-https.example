# Copy these values to frontend/.env for HTTPS LAN testing.
# Replace 192.168.20.140 with this computer's current Wi-Fi IPv4 address.
# Generate the ignored certificates with the documented mkcert command.
# Vite proxies secure browser requests to the existing HTTP FastAPI backend.
VITE_HTTPS=true
VITE_USE_VITE_PROXY=true
VITE_BACKEND_HOST=192.168.20.140
VITE_HTTPS_CERT_FILE=certs/linguasync.pem
VITE_HTTPS_KEY_FILE=certs/linguasync-key.pem
